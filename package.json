{
  "name": "claudecode-switchboard",
  "version": "0.1.0",
  "description": "Local dashboard for every Claude Code session on your Mac — status, live token burn, plan usage, and messages flying between sessions.",
  "keywords": ["claude-code", "dashboard", "tokens", "usage", "macos"],
  "license": "MIT",
  "repository": "github:itssarthak/claudecode-switchboard",
  "type": "commonjs",
  "main": "claude-sessions.js",
  "bin": { "switchboard": "claude-sessions.js" },
  "files": ["claude-sessions.js", "claude-sessions.html", "claude-sessions.sh", "README.md", "LICENSE"],
  "scripts": {
    "start": "node claude-sessions.js",
    "report": "node claude-sessions.js --report",
    "test": "node claude-sessions.js --selftest"
